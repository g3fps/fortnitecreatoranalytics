{
  "name": "fortnite-creator-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Competitive intelligence dashboard for Fortnite Creative/UEFN island creators, built on Epic's public Ecosystem Data API.",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "serve": "node src/main.js --no-crawl",
    "crawl-only": "node src/main.js --no-server",
    "crawl": "node scripts/crawl-once.js",
    "crawler-status": "node scripts/crawler-status.js",
    "test": "node --test scripts/smoke-test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/supabase-js": "^2.110.2",
    "express": "^4.19.2",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "pg": "^8.22.0"
  }
}
